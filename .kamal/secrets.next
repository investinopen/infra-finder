SECRETS=$(kamal secrets fetch --adapter doppler --from infra-finder/next DIGITALOCEAN_ACCESS_TOKEN RAILS_MASTER_KEY DATABASE_URL QUEUE_DATABASE_URL CACHE_DATABASE_URL S3_ACCESS_KEY_ID S3_SECRET_ACCESS_KEY SECURITY_HASH_SALT SECURITY_NODE_SALT)

DIGITALOCEAN_ACCESS_TOKEN=$(kamal secrets extract DIGITALOCEAN_ACCESS_TOKEN ${SECRETS})
RAILS_MASTER_KEY=$(kamal secrets extract RAILS_MASTER_KEY ${SECRETS})
DATABASE_URL=$(kamal secrets extract DATABASE_URL ${SECRETS})
QUEUE_DATABASE_URL=$(kamal secrets extract QUEUE_DATABASE_URL ${SECRETS})
CACHE_DATABASE_URL=$(kamal secrets extract CACHE_DATABASE_URL ${SECRETS})
S3_ACCESS_KEY_ID=$(kamal secrets extract S3_ACCESS_KEY_ID ${SECRETS})
S3_SECRET_ACCESS_KEY=$(kamal secrets extract S3_SECRET_ACCESS_KEY ${SECRETS})
SECURITY_HASH_SALT=$(kamal secrets extract SECURITY_HASH_SALT ${SECRETS})
SECURITY_NODE_SALT=$(kamal secrets extract SECURITY_NODE_SALT ${SECRETS})
