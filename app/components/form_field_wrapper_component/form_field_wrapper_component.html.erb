<%= tag.div class: [(conditional? ? "conditional-field-wrapper" : "form-field-wrapper"), class_name, ("form-field-wrapper--required" if required?)], data: { controller: "form-field-wrapper-component--form-field-wrapper-component", condition_field:, condition_value: } do %>
  <%= label %>
  <div class="field-content">
    <%= content %>
    <div class="field-meta">
      <% if description.present? %>
        <span class="field-description"><%= description %></span>
      <% end %>
      <span class="field-counter" data-form-field-wrapper-component--form-field-wrapper-component-target="counter" hidden></span>
    </div>
    <p class="field-error" data-form-field-wrapper-component--form-field-wrapper-component-target="error" hidden></p>
  </div>
  <% conditional_fields.each do |conditional_field| %>
    <%= conditional_field %>
  <% end %>
<% end %>
