<%= tag.div class: ["form-field-wrapper", class_name, ("form-field-wrapper--required" if required?)], data: { controller: "form-field-wrapper-component--form-field-wrapper-component", condition_field:, condition_value: } do %>
  <%= content %>
  <% if description.present? %>
    <div class="form-field-wrapper__meta">
      <span><%= description %></span>
      <span class="form-field-wrapper__counter" data-form-field-wrapper-component--form-field-wrapper-component-target="counter" hidden></span>
    </div>
  <% end %>
<% end %>
