<section id="<%= WRAPPER_ID %>">
  <div class="l-container l-container--narrow">
    <div class="l-container__inner">
      <header class="intake-header">
        <h1 class="text-lg font-semibold">Infra Finder Intake Form</h1>
        <span class="text-h1 block">We'd love for you to be in Infra Finder</span>
        <div class="a-underline"></div>
      </header>
      <div class="intake-instructions t-rte">
        <p>
          Required fields are marked with a red asterisk (<span class="required"></span>). Other fields are highly encouraged when applicable.
        </p>
        <p>
          You can <a target="blank" href="https://drive.google.com/file/d/1yUuTJTQ8uxG96zFTyoHThEhRmKeWIOGF/view?usp=drive_link">download a full copy of the intake form</a> to preview questions as you gather information.
        </p>
      </div>
    </div>
  </div>

  <%= render IntakeFormNavComponent.new %>

  <div class="l-container l-container--narrow pt-6">
    <div class="l-container__inner">
      <%= form_for solution_intake, html: { id: FORM_ID, multipart: true, data: form_data } do |f| %>
        <%= render IntakeErrorSummaryComponent.new(solution_intake:) %>
        <%= render IntakeFormSectionComponent.new(title: "Overview", anchor: "overview", help: true, help_href: "https://docs.google.com/document/d/1afiDj8pw2qxJcj7e6vhIRfP7Ra7gY0FYtsZ5DivQfwM/edit#heading=h.8wl1najndesi") do %>
          <%= render FormFieldWrapperComponent.new(description: "Your first name", required: true) do |field| %>
            <% field.with_label do %>
              <%= f.label :first_name %>
            <% end %>
            <%= f.text_field :first_name, required: true, maxlength: max_length(:first_name) %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(description: "Your last name", required: true) do |field| %>
            <% field.with_label do %>
              <%= f.label :last_name %>
            <% end %>
            <%= f.text_field :last_name, required: true, maxlength: max_length(:last_name) %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(description: "Your email address formatted as example@example.com", required: true) do |field| %>
            <% field.with_label do %>
              <%= f.label :email %>
            <% end %>
            <%= f.email_field :email, required: true %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(class_name: "start", description: "A solution is a tool, product, or infrastructure component. In some cases, the solution may be the same as the provider.", required: true) do |field| %>
            <% field.with_label do %>
              <%= f.label :name, "Solution name" %>
            <% end %>
            <%= f.text_field :name, required: true, maxlength: max_length(:name) %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(description: "A provider is a formal or informal organization responsible for running a solution. In some cases, the provider may be the same as the solution.") do |field| %>
            <% field.with_label do %>
              <%= f.label :provider_name %>
            <% end %>
            <%= f.text_field :provider_name, readonly: true, name: nil %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(description: "Upload a logo image, or provide a public link to one. The logo should display properly on a light background.") do |field| %>
            <% field.with_label do %>
              <%= tag.label "Logo" %>
            <% end %>
            <%= render IntakeLogoFieldComponent.new(form: f) %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(description: "Location of incorporation of the solution or provider or geographical area of primary activity.") do |field| %>
            <% field.with_label do %>
              <%= f.label :country_code, "Location" %>
            <% end %>
            <%= f.select :country_code, ControlledVocabulary.country_options, include_blank: "Select a location"  %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(description: "Primary web presence of the solution. URL should start with https://.", required: true) do |field| %>
            <% field.with_label do %>
              <%= f.label :website %>
            <% end %>
            <%= f.url_field :website, required: true %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(description: "Contact form or email address potential adopters can use to get additional information (https://www.example.com OR example@email.com)") do |field| %>
            <% field.with_label do %>
              <%= f.label :contact, "Public contact information" %>
            <% end %>
            <%= f.text_field :contact %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(description: "URL for the provider or solution's Research Organization Registry identifier.") do |field| %>
            <% field.with_label do %>
              <%= f.label :research_organization_registry_url, "Research Organization Registry ID" %>
            <% end %>
            <%= f.url_field :research_organization_registry_url %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(class_name: "wide") do |field| %>
            <% field.with_label do %>
              <%= tag.label "Persistent identifiers", id: "registries-label" %>
            <% end %>
            <%= render IntakeStructuredListComponent.new(form: f, attr: :registries, fields: [:name, :url], labelled_by: "registries-label", description: "Identifiers from other registries, such as re3data or FAIRsharing.") %>
          <% end %>
        <% end %>

        <%= render IntakeFormSectionComponent.new(title: "About", anchor: "about", help_href: "https://docs.google.com/document/d/1afiDj8pw2qxJcj7e6vhIRfP7Ra7gY0FYtsZ5DivQfwM/edit#heading=h.4tpeirkftzoe") do %>
          <%= render FormFieldWrapperComponent.new(required: true, description: "Year that the solution was first made available to users.") do |field| %>
            <% field.with_label do %>
              <%= f.label :launch_year, "Launch year" %>
            <% end %>
            <%= f.number_field :launch_year, required: true, min: 1960, max: Date.current.year %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(class_name: "wide") do %>
            <p class="t-rte">
              Solution category describes the function(s) the solution is primarily designed for, or how adopters primarily use the solution. Suggest up to three (3).
              While we'll do our best to use your suggestion(s), the final decision will rest with Invest in Open Infrastructure. Refer to our
              <a href="https://docs.google.com/document/d/1afiDj8pw2qxJcj7e6vhIRfP7Ra7gY0FYtsZ5DivQfwM/edit?tab=t.0#heading=h.cbyni299q9j3">solution category definitions</a> for more details.
            </p>
          <% end %>
          <%= render FormFieldWrapperComponent.new(required: true, class_name: "start") do |field| %>
            <% field.with_label do %>
              <%= tag.label "Solution category", id: "solution-categories-label" %>
            <% end %>
            <%= render TypeaheadComponent.new(form: f, attr: :solution_category_ids, vocab_name: "soln_cat", max_items: 3, labelled_by: "solution-categories-label", placeholder: "Type to search categories…", max_items_placeholder: "Max selected. Remove a category to search...", required: true) %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(required: true) do |field| %>
            <% field.with_label do %>
              <%= tag.label "Domain relevance", id: "domain-relevances-label" %>
            <% end %>
            <%= render TypeaheadComponent.new(form: f, attr: :domain_relevance_ids, vocab_name: "fos", labelled_by: "domain-relevances-label", placeholder: "Type to search domains…", description: "The research domain or domains that most closely reflect the focus of the solution.", required: true) %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(class_name: "wide", required: true, description: "An overview of the functions of the solution and its role in supporting research.") do |field| %>
            <% field.with_label do %>
              <%= f.label :service_summary, "Solution summary" %>
            <% end %>
            <%= f.text_area :service_summary, required: true, maxlength: max_length(:service_summary), rows: 5 %>
          <% end %>
        <% end %>

        <%= render IntakeFormSectionComponent.new(title: "Mission", anchor: "mission", help_href: "https://docs.google.com/document/d/1afiDj8pw2qxJcj7e6vhIRfP7Ra7gY0FYtsZ5DivQfwM/edit#heading=h.urucecck2tmi") do %>
          <%= render FormFieldWrapperComponent.new(class_name: "wide", required: true, description: "Mission statement or description of problems the solution addresses.") do |field| %>
            <% field.with_label do %>
              <%= f.label :mission %>
            <% end %>
            <%= f.text_area :mission, required: true, maxlength: max_length(:mission), rows: 5 %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(class_name: "wide", description: "Narrative description of up to three recent milestones or achievements that demonstrate growth or progress, such as usage or adoption milestones, deployment of major features or new versions, staff additions or changes in leadership.") do |field| %>
            <% field.with_label do %>
              <%= f.label :key_achievements %>
            <% end %>
            <%= f.text_area :key_achievements, maxlength: max_length(:key_achievements), rows: 5 %>
          <% end %>
        <% end %>

        <%= render IntakeFormSectionComponent.new(title: "Technical attributes", anchor: "technical", help_href: "https://docs.google.com/document/d/1afiDj8pw2qxJcj7e6vhIRfP7Ra7gY0FYtsZ5DivQfwM/edit#heading=h.yv96x9v5kb47") do %>
          <%= render FormFieldWrapperComponent.new(required: true, description: "Does the solution maintain a public repository where the full source code is stored and shared openly, allowing anyone to access, inspect, modify, or contribute to it? Code repositories that only contain plug-ins or community contributions, or that lack critical components for running the solution do not meet the criteria for inclusion.") do |field| %>
            <% field.with_label do %>
              <%= f.label :code_repository_implementation, "Open code repository" %>
            <% end %>
            <%= f.select :code_repository_implementation, vocab_options("impl_scale") %>
            <% field.with_conditional_field(condition: { field: :code_repository_implementation, value: "available" }, description: "Provide a public link to your primary code repository. Links should start with https://.") do |field| %>
              <% field.with_label do %>
                <%= f.label :code_repository, "Link to open code repository", for: implementation_url_field_id(f, :code_repository) %>
              <% end %>
              <%= implementation_url_field(f, :code_repository) %>
            <% end %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(required: true, description: "The solution's maintenance status. Evidence of active maintenance may include regular commits and issue resolutions in a GitHub repository, activity in community and support forums.") do |field| %>
            <% field.with_label do %>
              <%= f.label :maintenance_status_id, "Maintenance status" %>
            <% end %>
            <%= f.select :maintenance_status_id, vocab_options("maint"), selected: solution_intake.maintenance_status_id || vocab_option_value("maint", "Unknown") %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(required: true, description: "Does your solution maintain public documentation that meaningfully describes the process for users to install, configure, maintain, and troubleshoot the code for running the solution. OR, in the case of solutions not reliant on client installs, documentation that meaningfully describes how users perform tasks on the platform to utilize the solution?") do |field| %>
            <% field.with_label do %>
              <%= f.label :user_documentation_implementation, "Technical documentation" %>
            <% end %>
            <%= f.select :user_documentation_implementation, vocab_options("impl_scale") %>
            <% field.with_conditional_field(condition: { field: :user_documentation_implementation, value: "available" }, description: "Provide a public link to your technical documentation. Links should start with https://.") do |field| %>
              <% field.with_label do %>
                <%= f.label :user_documentation, "Link to technical documentation", for: implementation_url_field_id(f, :user_documentation) %>
              <% end %>
              <%= implementation_url_field(f, :user_documentation) %>
            <% end %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(required: true, description: "Does your solution maintain publicly available documentation outlining the priorities and progress for product development?") do |field| %>
            <% field.with_label do %>
              <%= f.label :product_roadmap_implementation, "Open product roadmap" %>
            <% end %>
            <%= f.select :product_roadmap_implementation, vocab_options("impl_scale") %>
            <% field.with_conditional_field(condition: { field: :product_roadmap_implementation, value: "available" }, description: "Provide a public link to your product roadmap. Links should start with https://.") do |field| %>
              <% field.with_label do %>
                <%= f.label :product_roadmap, "Link to product roadmap", for: implementation_url_field_id(f, :product_roadmap) %>
              <% end %>
              <%= implementation_url_field(f, :product_roadmap) %>
            <% end %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(required: true, description: "Does your solution maintain public application programming interfaces (APIs) that provide developers with programmatic access to content and/or metadata?") do |field| %>
            <% field.with_label do %>
              <%= f.label :open_api_implementation, "Open APIs" %>
            <% end %>
            <%= f.select :open_api_implementation, vocab_options("impl_scale") %>
            <% field.with_conditional_field(condition: { field: :open_api_implementation, value: "available" }, description: "Provide a public link to your primary API. Separate multiple links with a comma. Links should start with https://.") do |field| %>
              <% field.with_label do %>
                <%= f.label :open_api, "Link to API(s)", for: implementation_url_field_id(f, :open_api) %>
              <% end %>
              <%= implementation_url_field(f, :open_api) %>
            <% end %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(required: true, description: "Public statement describing the solution's commitment to the use and availability of their data, allowing the data to be accessed to the extent possible.") do |field| %>
            <% field.with_label do %>
              <%= f.label :open_data_implementation, "Open data statement" %>
            <% end %>
            <%= f.select :open_data_implementation, vocab_options("impl_scale") %>
            <% field.with_conditional_field(condition: { field: :open_data_implementation, value: "available" }, description: "Public link to open data statement. Links should start with https://.") do |field| %>
              <% field.with_label do %>
                <%= f.label :open_data, "Link to open data statement", for: implementation_url_field_id(f, :open_data) %>
              <% end %>
              <%= implementation_url_field(f, :open_data) %>
            <% end %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(description: "The solution's readiness for broad adoption, adapted from the framework developed by the Horizon 2020 project.") do |field| %>
            <% field.with_label do %>
              <%= f.label :readiness_level_id, "Technology readiness level" %>
            <% end %>
            <%= f.select :readiness_level_id, vocab_options("tech_read"), include_blank: "Select a level" %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(class_name: "wide") do |field| %>
            <% field.with_label do %>
              <%= tag.label " Primary programming languages used in the tool or solution's source code", id: "programming-languages-label" %>
            <% end %>
            <%= render IntakeCheckboxGroupComponent.new(form: f, attr: :programming_language_ids, vocab_name: "prgrm_lng", labelled_by: "programming-languages-label") %>
            <% field.with_conditional_field(condition: { field: :programming_language_ids, value: vocab_option_value("prgrm_lng", "Other") }) do |field| %>
              <% field.with_label do %>
                <%= f.label :programming_language_other, "If \"other,\" please list the primary programming languages used in the tool or solution's source code" %>
              <% end %>
              <%= f.text_field :programming_language_other, maxlength: max_length(:programming_language_other) %>
            <% end %>
          <% end %>
          <%= render FormFieldWrapperComponent.new do |field| %>
            <% field.with_label do %>
              <%= tag.label "If you publish content, what licenses do you use, require, or support?", id: "content-licenses-label" %>
            <% end %>
            <%= render IntakeCheckboxGroupComponent.new(form: f, attr: :content_license_ids, vocab_name: "cont_lcns", labelled_by: "content-licenses-label") %>
            <% field.with_conditional_field(condition: { field: :content_license_ids, value: vocab_option_value("cont_lcns", "Other") }) do |field| %>
              <% field.with_label do %>
                <%= f.label :content_license_other, "If \"other,\" please list the content licenses you use, require, or support" %>
              <% end %>
              <%= f.text_field :content_license_other, maxlength: max_length(:content_license_other) %>
            <% end %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(required: true, class_name: "wide", description: "Indication of whether the solution applies a standard open software license to its primary source code.") do |field| %>
            <% field.with_label do %>
              <%= f.label :code_license_implementation, "Open code license" %>
            <% end %>
            <%= f.select :code_license_implementation, vocab_options("impl_scale") %>
            <% field.with_conditional_field(condition: { field: :code_license_implementation, value: "available" }, description: "Link to the code license attached to the tool's primary source code repository. Links should start with https://.") do |field| %>
              <% field.with_label do %>
                <%= f.label :code_license, "Link to code license", for: implementation_url_field_id(f, :code_license) %>
              <% end %>
              <%= implementation_url_field(f, :code_license) %>
            <% end %>
            <% field.with_conditional_field(condition: { field: :code_license_implementation, value: "available" }) do |field| %>
              <% field.with_label do %>
                <%= tag.label "What types of code license are attached to the tool's primary source code repository?", id: "licenses-label" %>
              <% end %>
              <%= render IntakeCheckboxGroupComponent.new(form: f, attr: :license_ids, vocab_name: "code_lcns", labelled_by: "licenses-label") %>
              <%= render FormFieldWrapperComponent.new(condition: { field: :license_ids, value: vocab_option_value("code_lcns", "Other") }, conditional: true) do |field| %>
                <% field.with_label do %>
                  <%= f.label :license_other, "If \"other,\" please list to the code license(s) attached to the tool's primary source code repository" %>
                <% end %>
                <%= f.text_field :license_other, maxlength: max_length(:license_other) %>
              <% end %>
            <% end %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(class_name: "wide") do %>
            <p class="t-rte">
              This section asks you to indicate which standards and protocols the solution supports in a range of categories. Select all that apply.
            </p>
          <% end %>
          <%= render FormFieldWrapperComponent.new(class_name: "wide") do |field| %>
            <% field.with_label do %>
              <%= tag.label "Metadata, markup, and information exchange standards", id: "metadata-standards-label" %>
            <% end %>
            <%= render TypeaheadComponent.new(form: f, attr: :metadata_standard_ids, vocab_name: "standards_metadata", labelled_by: "metadata-standards-label", placeholder: "Type to search standards…") %>
            <% field.with_conditional_field(condition: { field: :metadata_standard_ids, value: vocab_option_value("standards_metadata", "Other") }) do |field| %>
              <% field.with_label do %>
                <%= f.label :metadata_standard_other, "What other metadata, markup, and information exchange standards do you support?" %>
              <% end %>
              <%= f.text_field :metadata_standard_other, maxlength: max_length(:metadata_standard_other) %>
            <% end %>
          <% end %>
          <%= render FormFieldWrapperComponent.new do |field| %>
            <% field.with_label do %>
              <%= tag.label "Security standards", id: "security-standards-label" %>
            <% end %>
            <%= render IntakeCheckboxGroupComponent.new(form: f, attr: :security_standard_ids, vocab_name: "standards_sec", labelled_by: "security-standards-label") %>
            <% field.with_conditional_field(condition: { field: :security_standard_ids, value: vocab_option_value("standards_sec", "Other") }) do |field| %>
              <% field.with_label do %>
                <%= f.label :security_standard_other, "What other security standards do you support?" %>
              <% end %>
              <%= f.text_field :security_standard_other, maxlength: max_length(:security_standard_other) %>
            <% end %>
          <% end %>
          <%= render FormFieldWrapperComponent.new do |field| %>
            <% field.with_label do %>
              <%= tag.label "Authentication protocols", id: "authentication-standards-label" %>
            <% end %>
            <%= render IntakeCheckboxGroupComponent.new(form: f, attr: :authentication_standard_ids, vocab_name: "standards_auth", labelled_by: "authentication-standards-label") %>
            <% field.with_conditional_field(condition: { field: :authentication_standard_ids, value: vocab_option_value("standards_auth", "Other") }) do |field| %>
              <% field.with_label do %>
                <%= f.label :authentication_standard_other, "What other authentication protocols do you support?" %>
              <% end %>
              <%= f.text_field :authentication_standard_other, maxlength: max_length(:authentication_standard_other) %>
            <% end %>
          <% end %>
          <%= render FormFieldWrapperComponent.new do |field| %>
            <% field.with_label do %>
              <%= tag.label "Persistent identifiers", id: "persistent-identifier-standards-label" %>
            <% end %>
            <%= render IntakeCheckboxGroupComponent.new(form: f, attr: :persistent_identifier_standard_ids, vocab_name: "standards_pids", labelled_by: "persistent-identifier-standards-label") %>
            <% field.with_conditional_field(condition: { field: :persistent_identifier_standard_ids, value: vocab_option_value("standards_pids", "Other") }) do |field| %>
              <% field.with_label do %>
                <%= f.label :persistent_identifier_standard_other, "What other persistent identifiers do you support?" %>
              <% end %>
              <%= f.text_field :persistent_identifier_standard_other, maxlength: max_length(:persistent_identifier_standard_other) %>
            <% end %>
          <% end %>
          <%= render FormFieldWrapperComponent.new do |field| %>
            <% field.with_label do %>
              <%= tag.label "Preservation standards", id: "preservation-standards-label" %>
            <% end %>
            <%= render IntakeCheckboxGroupComponent.new(form: f, attr: :preservation_standard_ids, vocab_name: "standards_pres", labelled_by: "preservation-standards-label") %>
            <% field.with_conditional_field(condition: { field: :preservation_standard_ids, value: vocab_option_value("standards_pres", "Other") }) do |field| %>
              <% field.with_label do %>
                <%= f.label :preservation_standard_other, "What other preservation standards do you support?" %>
              <% end %>
              <%= f.text_field :preservation_standard_other, maxlength: max_length(:preservation_standard_other) %>
            <% end %>
          <% end %>
          <%= render FormFieldWrapperComponent.new do |field| %>
            <% field.with_label do %>
              <%= tag.label "Metrics reporting", id: "metrics-standards-label" %>
            <% end %>
            <%= render IntakeCheckboxGroupComponent.new(form: f, attr: :metrics_standard_ids, vocab_name: "standards_metrics", labelled_by: "metrics-standards-label") %>
            <% field.with_conditional_field(condition: { field: :metrics_standard_ids, value: vocab_option_value("standards_metrics", "Other") }) do |field| %>
              <% field.with_label do %>
                <%= f.label :metrics_standard_other, "What other metrics reporting standards do you support?" %>
              <% end %>
              <%= f.text_field :metrics_standard_other, maxlength: max_length(:metrics_standard_other) %>
            <% end %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(required: true, class_name: "wide", description: "Indication of whether the software can be hosted, deployed, configured, maintained, or otherwise serviced by a vendor, whether the solution provider or a third party.") do |field| %>
            <% field.with_label do %>
              <%= f.label :hosting_strategy_id, "Hosting and software as a service (SaaS) options" %>
            <% end %>
            <%= f.select :hosting_strategy_id, vocab_options("saas"), { include_blank: "Select an option" }, required: true %>
            <% field.with_conditional_field(condition: { field: :hosting_strategy_id, value: vocab_option_values("saas", "Through third party vendor only", "Through solution provider or third party vendor") }) do |field| %>
              <% field.with_label do %>
                <%= tag.label "Service providers", id: "service-providers-label" %>
              <% end %>
              <%= render IntakeStructuredListComponent.new(form: f, attr: :service_providers, fields: [:name, :url], labelled_by: "service-providers-label", description: "Link to a public registry of approved third party vendors or to a description of SaaS options available. Links should start with https://.") %>
            <% end %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(class_name: "wide") do |field| %>
            <% field.with_label do %>
              <%= tag.label "Integrations and compatibility", id: "integrations-label" %>
            <% end %>
            <%= render TypeaheadComponent.new(form: f, attr: :integration_ids, vocab_name: "integrations", labelled_by: "integrations-label", placeholder: "Type to search integrations…") %>
          <% end %>
        <% end %>

        <%= render IntakeFormSectionComponent.new(title: "Community engagement", anchor: "community", help_href: "https://docs.google.com/document/d/1afiDj8pw2qxJcj7e6vhIRfP7Ra7gY0FYtsZ5DivQfwM/edit#heading=h.3gbznbxi2gon") do %>
          <%= render FormFieldWrapperComponent.new(required: true, description: "Does your solution actively maintain and enforce a code of conduct? A code of conduct is a public document describing the expectations, norms, rules, and responsibilities for individuals participating in physical and digital communities. It should also provide explicit pathways for reporting violations and indicate how reports will be addressed and resolved.") do |field| %>
            <% field.with_label do %>
              <%= f.label :code_of_conduct_implementation, "Code of conduct" %>
            <% end %>
            <%= f.select :code_of_conduct_implementation, vocab_options("impl_scale") %>
            <% field.with_conditional_field(condition: { field: :code_of_conduct_implementation, value: "available" }, description: "Link to the public code of conduct and reporting guidelines. Links should start with https://.") do |field| %>
              <% field.with_label do %>
                <%= f.label :code_of_conduct, "Link to code of conduct", for: implementation_url_field_id(f, :code_of_conduct) %>
              <% end %>
              <%= implementation_url_field(f, :code_of_conduct) %>
            <% end %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(required: true, description: "Public stated interest in and evidence of available resources for engaging with the solution's stakeholder community in a meaningful way. This may include staff explicitly tasked with community engagement, evidence of regular community involvement in major decisions, and community-driven governance.") do |field| %>
            <% field.with_label do %>
              <%= f.label :community_engagement_implementation, "Commitment to community engagement" %>
