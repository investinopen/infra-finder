            <% end %>
            <%= f.select :financial_reporting_level_id, vocab_options("rprt_lvl"), include_blank: "Select a level" %>
            <% field.with_conditional_field(condition: { field: :financial_reporting_level_id, value: vocab_option_value("rprt_lvl", "Other") }) do |field| %>
              <% field.with_label do %>
                <%= f.label :financial_reporting_level_other, "To what entity does your financial information apply?" %>
              <% end %>
              <%= f.text_field :financial_reporting_level_other, maxlength: max_length(:financial_reporting_level_other) %>
            <% end %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(description: "Link to publicly or privately available documentation that validates the financial numbers reported. Examples include annual reports or IRS Form 990 for US-based non-profits. Links should start with https://.") do |field| %>
            <% field.with_label do %>
              <%= f.label :financial_numbers_documented_url, "Financial documentation" %>
            <% end %>
            <%= f.url_field :financial_numbers_documented_url %>
          <% end %>
          <%= render FormFieldWrapperComponent.new(class_name: "wide") do |field| %>
            <% field.with_label do %>
              <%= tag.label "Top granting institutions", id: "top-granting-institutions-label" %>
            <% end %>
            <%= render IntakeStructuredListComponent.new(form: f, attr: :top_granting_institutions, fields: [:name, :url], labelled_by: "top-granting-institutions-label", description: "List or organizations that have provided the greatest amount of grant funds to the solution or provider in the past year.") %>
          <% end %>
        <% end %>

        <%= render IntakeFormSectionComponent.new(title: "Consent", anchor: "consent", help: false) do %>
          <%= render FormFieldWrapperComponent.new(class_name: "wide") do %>
            <p class="t-rte">
              By submitting this intake form you acknowledge that you have read, and on behalf of the applicable provider,
              agree that IOI may use the information you've submitted below in accordance with
              IOI's Terms & Conditions and
              Privacy Policy.
            </p>
          <% end %>
          <%= render FormFieldWrapperComponent.new(class_name: "wide", required: true) do |field| %>
            <% field.with_label do %>
              <label class="m-checkbox consent-checkbox">
                <%= check_box_tag "terms_and_privacy_agreement", "1", consented?, required: true, data: consent_data %>
                <span>I agree to the terms &amp; conditions and privacy policy.</span>
              </label>
            <% end %>
          <% end %>
        <% end %>

        <%= f.submit "Submit", class: "m-button m-button--lg bg-black", data: submit_data %>
      <% end %>
    </div>
  </div>
</section>
