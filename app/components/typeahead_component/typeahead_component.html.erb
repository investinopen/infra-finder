<% data = { controller: "typeahead-component--typeahead-component" }
   data["typeahead-component--typeahead-component-max-items-value"] = max_items if max_items
   data["typeahead-component--typeahead-component-placeholder-value"] = placeholder if placeholder.present?
   data["typeahead-component--typeahead-component-max-items-placeholder-value"] = max_items_placeholder if max_items_placeholder.present? %>
<%= tag.div class: "typeahead-component" do %>
  <%= form.select attr,
        options.map { |label, value, _props| [label, value] },
        { include_hidden: false },
        multiple: true,
        class: "typeahead-component__select",
        aria: { labelledby: labelled_by },
        data: data %>
<% end %>
