module Types
  # @see <%= @implementation.type.name %>
  # @see Types::<%= graphql_implementation_type_name(@implementation) %>
  class <%= graphql_implementation_input_type_name(@implementation) %> < Types::BaseInputObject
    description <<~TEXT
    How a solution implements `<%= @implementation.name %>`. Its status is the `<%= @implementation.enum.camelize(:lower) %>` argument.
    TEXT
<% graphql_implementation_fields_for(@implementation).each do |name, graphql_type| -%>

    argument :<%= name %>, <%= graphql_type.gsub("ImplementationLinkType", "ImplementationLinkInputType") %>, required: false<%= ", validates: { allow_null: false }" if name.in?(%w[link links]) %>
<% end -%>
  end
end
