# frozen_string_literal: true

# This file is generated by `bin/rails generate solution_properties`.
# Do not edit it by hand.

module Types
  # @see <%= @implementation.type.name %>
  class <%= graphql_implementation_type_name(@implementation) %> < Types::BaseObject
    description <<~TEXT
    How a solution implements `<%= @implementation.name %>`. Its status is the `<%= @implementation.enum.camelize(:lower) %>` field.
    TEXT
<% graphql_implementation_fields_for(@implementation).each do |name, graphql_type| -%>

    field :<%= name %>, <%= graphql_type %>, null: <%= name != "links" %>
<% end -%>
<% if @implementation.has_single_link? -%>

    # An unset link is stored as an empty one.
    #
    # @return [Implementations::Link, nil]
    def link = object.link.presence
<% end -%>
  end
end
