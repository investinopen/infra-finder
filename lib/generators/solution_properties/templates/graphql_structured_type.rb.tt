# frozen_string_literal: true

# This file is generated by `bin/rails generate solution_properties`.
# Do not edit it by hand.

module Types
  # @see <%= @structured_model_type.name %>
  class <%= graphql_structured_type_name(@structured_model_type) %> < Types::BaseObject
    description <<~TEXT
    A structured `<%= @structured_model_type.name.demodulize.underscore.humanize.downcase %>` entry on a solution.
    TEXT
<% graphql_structured_fields_for(@structured_model_type).each do |name, graphql_type| -%>

    field :<%= name %>, <%= graphql_type %>, null: true
<% end -%>
  end
end
