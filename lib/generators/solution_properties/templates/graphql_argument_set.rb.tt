# frozen_string_literal: true

# This file is generated by `bin/rails generate solution_properties`.
# Do not edit it by hand.

module Mutations
  module Shared
    # The properties a mutation can set on a {<%= @input_model_name %>}. Only the arguments provided
    # change; lists and implementation details are replaced as a whole.
    class <%= @input_model_name %>Attributes < VOGMutations::Arguments::SharedSet
<% graphql_input_properties(@input_kind).each_with_index do |prop, index| -%>
<% unless index.zero? -%>

<% end -%>
<% if prop.kind == :attachment -%>
      image_attachment! :<%= prop.attribute_name %>, clearable: true
<% next -%>
<% end -%>
<% name, type, loads, as = graphql_input_argument_for(prop) -%>
<% if loads -%>
      argument :<%= name %>, <%= type %>, required: false,
        loads: <%= loads %>, as: :<%= as %> do
<% else -%>
      argument :<%= name %>, <%= type %>, required: false do
<% end -%>
        description <<~TEXT
<%= graphql_description_for(prop).gsub(/(.{1,100})(\s+|\z)/, "\\1\n").rstrip.indent(8) %>
        TEXT
<% unless graphql_input_allows_null?(prop) -%>

        validates allow_null: false
<% end -%>
      end
<% end -%>
    end
  end
end
