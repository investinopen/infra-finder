# frozen_string_literal: true

# This file is generated by `bin/rails generate solution_properties`.
# Do not edit it by hand.

module Types
  # The solution properties shared by solutions, drafts, and intakes.
  #
  # @see SolutionInterface
  # @see SolutionProperty
  module SolutionInterfaceType
    include Types::BaseInterface

    description <<~TEXT
    The properties shared by solutions, drafts, and intakes.
    TEXT
<% graphql_interface_properties.each do |prop| -%>
<% type, nullable = graphql_field_type_for(prop) -%>

    field :<%= graphql_field_name_for(prop) %>, <%= type %>, null: <%= nullable %> do
      description <<~TEXT
<%= graphql_description_for(prop).gsub(/(.{1,100})(\s+|\z)/, "\\1\n").rstrip.indent(6) %>
      TEXT
    end
<% end -%>
<% graphql_interface_properties.each do |prop| -%>
<% if prop.association_name.present? -%>

    # @return [<%= prop.association_name.camelize %>, nil]
    def <%= prop.association_name %> = association_loader_for(<%= prop.association_name.to_sym.inspect %>)
<% elsif prop.kind == :implementation -%>

    # @return [Implementations::GraphQLView]
    def <%= prop.name %> = ::Implementations::GraphQLView.new(object, ::Implementation.find(<%= prop.name.inspect %>))
<% elsif prop.kind.in?(%i[single_option multi_option]) && prop.vocab.uses_model? -%>

    # @return [<%= prop.kind == :multi_option ? "<#{prop.vocab.model_name}>" : "#{prop.vocab.model_name}, nil" %>]
    def <%= prop.attribute_name %> = association_loader_for(<%= prop.attribute_name.to_sym.inspect %>)
<% end -%>
<% end -%>
  end
end
