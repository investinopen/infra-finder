# frozen_string_literal: true

# This file is generated by `bin/rails generate controlled_vocabulary_graphql`.
# Do not edit it by hand.

module Types
  # @see <%= vocab.model_name %>
  class <%= vocab.model_name %>Type < Types::AbstractControlledVocabularyRecord
    description <<~TEXT
    A record in the `<%= vocab.name %>` controlled vocabulary.
    TEXT

    # Columns beyond those in {Types::ControlledVocabularyRecordType}.
    # @see Types::ControlledVocabularyType#extra_fields
    EXTRA_FIELDS = [
<% extra_fields.each do |name, graphql_type, nullable| -%>
      { name: <%= name.inspect %>, type: <%= graphql_type.underscore.upcase.inspect %>, required: <%= !nullable %> },
<% end -%>
    ].freeze
<% extra_fields.each do |name, graphql_type, nullable| -%>

    field :<%= name %>, <%= graphql_type %>, null: <%= nullable %> do
      description "The record's `<%= name %>`."
    end
<% end -%>
  end
end
