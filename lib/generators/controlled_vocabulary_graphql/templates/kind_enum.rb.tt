module Types
  # @see ControlledVocabulary
  class ControlledVocabularyKindType < Types::BaseEnum
    description <<~TEXT
    The controlled vocabularies that solutions are described with.
    TEXT
<% vocabs.each do |v| -%>

    value <%= enum_value_for(v).inspect %>, value: <%= v.model_name.inspect %> do
      description "Terms for `<%= v.model_klass.model_name.human.pluralize %>`."
    end
<% end -%>

    # The object type for every kind, by name. They are registered with the
    # schema because they are only reachable through {Types::ControlledVocabularyRecordType}.
    OBJECT_TYPE_NAMES = [
<% vocabs.each do |v| -%>
      "::Types::<%= v.model_name %>Type",
<% end -%>
    ].freeze

    class << self
      # @return [<Class>]
      def object_types = OBJECT_TYPE_NAMES.map(&:constantize)
    end
  end
end
