# frozen_string_literal: true

module Types
  # @see ::<%= class_name %>
  # @see ::<%= transition_class_name %>
  # @see ::<%= full_state_machine_class_name %>
  class <%= enum_type_class_name %> < Types::BaseEnum
    description <<~TEXT
    The current state of a `<%= class_name %>`.
    TEXT
    <%- states.each do |state| -%>

    value <%= state.enum_name %>, value: <%= state.enum_value %> do
      description <<~TEXT
      The <%= owner_words %> is in the `<%= state.human %>` state.
      TEXT
    end
    <%- end -%>
  end
end
