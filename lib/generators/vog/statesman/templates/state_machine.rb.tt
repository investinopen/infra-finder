# frozen_string_literal: true

module <%= service_namespace %>
  # The state machine governing a {<%= class_name %>}'s state transitions.
  #
  # @see <%= class_name %>
  # @see <%= transition_class_name %>
  # @see ::<%= full_enum_type_class_name %>
  class StateMachine
    include Support::StatesmanHelpers::Machine

    <%- states.each do |state| -%>
    <%= state.machine_declaration %>
    <%- end -%>

    after_transition do |record, transition|
      record.update_column(:state, transition.to_state)
    end
  end
end
