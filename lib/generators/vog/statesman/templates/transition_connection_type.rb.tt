# frozen_string_literal: true

module Types
  # A connection type for {<%= transition_class_name %>}-typed records.
  #
  # @see <%= transition_class_name %>
  # @see ::<%= full_transition_edge_type_class_name %>
  # @see ::<%= full_transition_type_class_name %>
  class <%= transition_connection_type_class_name %> < Types::BaseConnection
    graphql_name "<%= transition_class_name %>Connection"

    description <<~TEXT
    A connection type for `<%= transition_class_name %>`.
    TEXT

    edge_type ::<%= full_transition_edge_type_class_name %>
  end
end
